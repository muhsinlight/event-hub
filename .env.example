# Copy to .env for local dev. Never commit .env (see .gitignore).
POSTGRES_DB=mydatabase
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

DB_URL=jdbc:postgresql://localhost:5432/mydatabase
DB_USERNAME=postgres
DB_PASSWORD=

JWT_SECRET=
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

RESEND_API_KEY=
RESEND_FROM=Event Hub <onboarding@resend.dev>

# Local admin (created on startup). Use these at /login — there is no automatic sign-in.
# Change both before any machine that is reachable from the internet.
ADMIN_EMAIL=admin@eventhub.local
ADMIN_PASSWORD=admin123

COOKIE_SECURE=false
